# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/depeer

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Paynow
PAYNOW_INTEGRATION_ID=your-paynow-integration-id
PAYNOW_INTEGRATION_KEY=your-paynow-integration-key
PAYNOW_RESULT_URL=http://localhost:4000/api/payments/result
PAYNOW_RETURN_URL=http://localhost:3000/investor/marketplace
